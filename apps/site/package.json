{
  "name": "@infoschematics/site",
  "description": "The official Infoschematics website, documentation and example host.",
  "version": "0.1.0",
  "dependencies": {
    "@infoschematics/domain-core": "0.1.0",
    "@infoschematics/is-blank": "0.1.0",
    "@infoschematics/is-infoschematics": "0.1.0",
    "@infoschematics/is-showcase": "0.1.0",
    "@infoschematics/render-svg": "0.1.0",
    "@infoschematics/view-canvas": "0.1.0",
    "@infoschematics/view-present": "0.1.0",
    "@infoschematics/view-studio": "0.1.0",
    "marked": "^18.0.11",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.0.3",
    "wrangler": "^4.123.0"
  },
  "private": true,
  "scripts": {
    "build": "vite build",
    "clean": "rm -rf dist .wrangler",
    "deploy": "bun run build && wrangler deploy",
    "ki:site:dev": "vite",
    "preview": "bun run build && wrangler dev",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "type": "module"
}
