{
  "name": "infoschematics",
  "description": "The Infoschematic domain model, framework-neutral view model, interactive views, authored examples, guidance, and public website.",
  "version": "0.1.0",
  "author": "Infoschematics",
  "bugs": {
    "url": "https://github.com/infoschematics/infoschematics/issues"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/node": "^22.20.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^4.0.3",
    "dependency-cruiser": "^18.2.0",
    "husky": "^9.1.7",
    "knip": "^6.34.0",
    "lint-staged": "^17.4.1",
    "playwright": "^1.63.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rumdl": "^0.2.64",
    "turbo": "^2.10.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.0.3",
    "vitest-browser-react": "^2.3.0"
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=22"
  },
  "homepage": "https://infoschematics.info/",
  "keywords": [
    "bun",
    "diagrams",
    "infoschematic",
    "react",
    "svg",
    "typescript",
    "visualization"
  ],
  "license": "MIT",
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,jsonc}": [
      "bunx @biomejs/biome check --write --no-errors-on-unmatched"
    ],
    "*.md": [
      "bunx rumdl check --fix"
    ]
  },
  "overrides": {
    "vite": "$vite"
  },
  "packageManager": "bun@1.4.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/infoschematics/infoschematics.git"
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "ki:deps:update": "bun update --latest",
    "ki:site:build": "bun run --cwd apps/site build",
    "ki:site:clean": "bun run --cwd apps/site clean",
    "ki:site:deploy": "bun run --cwd apps/site deploy",
    "ki:site:dev": "bun run --cwd apps/site ki:site:dev",
    "ki:site:preview": "bun run --cwd apps/site preview",
    "prepare": "husky",
    "self:boundaries:verify": "depcruise --config .dependency-cruiser.ts packages/domain-model/src packages/domain-core/src packages/view-model/src packages/view-canvas/src packages/view-present/src packages/view-studio/src packages/render-svg/src packages/cli/src examples/is-blank/src examples/is-infoschematics/src examples/is-system/src apps/site/src scripts",
    "self:cf:build": "bun run build",
    "self:check": "turbo run self:packages:check-versions build typecheck self:scripts:typecheck self:schema:verify self:tokens:verify self:examples:verify test self:boundaries:verify self:scripts:test test:browser",
    "self:dev": "turbo run build --filter=./packages/* && bun run ki:site:dev",
    "self:examples:generate": "bun scripts/examples.ts",
    "self:examples:render": "bun scripts/render-example.ts",
    "self:examples:verify": "bun scripts/examples.ts --check",
    "self:packages:build": "turbo run build --filter=./packages/*",
    "self:packages:check-versions": "bun scripts/release/check-versions.ts",
    "self:packages:clean": "turbo run clean --filter=./packages/*",
    "self:packages:pack-smoke": "bun scripts/release/pack-smoke.ts",
    "self:release:verify": "turbo run build --filter=./packages/* && bun run self:packages:pack-smoke",
    "self:schema:generate": "bun scripts/generate-schema.ts",
    "self:schema:verify": "bun scripts/generate-schema.ts --check",
    "self:scripts:test": "vitest run --root .",
    "self:scripts:typecheck": "tsc --noEmit -p tsconfig.scripts.json",
    "self:tokens:generate": "bun scripts/generate-visual-tokens.ts",
    "self:tokens:verify": "bun scripts/generate-visual-tokens.ts --check",
    "self:typecheck": "turbo run typecheck self:scripts:typecheck",
    "self:unused:verify": "bunx knip",
    "test": "turbo run test",
    "test:browser": "turbo run test:browser"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ]
}
