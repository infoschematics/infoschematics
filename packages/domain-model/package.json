{
  "name": "@infoschematics/domain-model",
  "description": "The framework-neutral Infoschematic domain model and serialisable configuration contract.",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/infoschematics/infoschematics.git",
    "directory": "packages/domain-model"
  },
  "engines": { "node": ">=22" },
  "publishConfig": { "access": "public" },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "bun run clean && tsc -p tsconfig.build.json && node build.mjs ../../LICENSE dist/LICENSE",
    "clean": "node build.mjs --clean"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./appearance": { "types": "./dist/appearance.d.ts", "import": "./dist/appearance.js" },
    "./artefact": { "types": "./dist/artefact.d.ts", "import": "./dist/artefact.js" },
    "./card": { "types": "./dist/card.d.ts", "import": "./dist/card.js" },
    "./domain": { "types": "./dist/domain.d.ts", "import": "./dist/domain.js" },
    "./fabric": { "types": "./dist/fabric.d.ts", "import": "./dist/fabric.js" },
    "./flow": { "types": "./dist/flow.d.ts", "import": "./dist/flow.js" },
    "./flow-family": { "types": "./dist/flow-family.d.ts", "import": "./dist/flow-family.js" },
    "./graphic": { "types": "./dist/graphic.d.ts", "import": "./dist/graphic.js" },
    "./geometry": { "types": "./dist/geometry.d.ts", "import": "./dist/geometry.js" },
    "./infoschematic": { "types": "./dist/infoschematic.d.ts", "import": "./dist/infoschematic.js" },
    "./interface": { "types": "./dist/interface.d.ts", "import": "./dist/interface.js" },
    "./lane": { "types": "./dist/lane.d.ts", "import": "./dist/lane.js" },
    "./metadata": { "types": "./dist/metadata.d.ts", "import": "./dist/metadata.js" },
    "./point": { "types": "./dist/point.d.ts", "import": "./dist/point.js" },
    "./ports": { "types": "./dist/ports.d.ts", "import": "./dist/ports.js" },
    "./scene": { "types": "./dist/scene.d.ts", "import": "./dist/scene.js" },
    "./scope": { "types": "./dist/scope.d.ts", "import": "./dist/scope.js" },
    "./specification-group": { "types": "./dist/specification-group.d.ts", "import": "./dist/specification-group.js" },
    "./story": { "types": "./dist/story.d.ts", "import": "./dist/story.js" },
    "./theme": { "types": "./dist/theme.d.ts", "import": "./dist/theme.js" },
    "./zone": { "types": "./dist/zone.d.ts", "import": "./dist/zone.js" }
  }
}
