{
  "name": "@infoschematics/view-present",
  "description": "The audience-facing Infoschematic view: presentation controls, scene focus and Story playback over Canvas.",
  "version": "0.1.0",
  "dependencies": {
    "@infoschematics/domain-model": "0.1.0",
    "@infoschematics/view-canvas": "0.1.0",
    "@infoschematics/view-model": "0.1.0"
  },
  "devDependencies": {
    "@infoschematics/domain-core": "0.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/infoschematics/infoschematics.git",
    "directory": "packages/view-present"
  },
  "scripts": {
    "build": "bun run clean && tsc -p tsconfig.build.json && node build.mjs src/styles.css dist/styles.css ../../LICENSE dist/LICENSE",
    "clean": "node build.mjs --clean"
  },
  "sideEffects": [
    "./dist/styles.css"
  ],
  "type": "module",
  "types": "./dist/index.d.ts"
}
