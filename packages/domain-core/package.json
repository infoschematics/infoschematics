{
  "name": "@infoschematics/domain-core",
  "description": "Framework-neutral Infoschematic domain behaviour and configuration normalisation.",
  "version": "0.1.0",
  "dependencies": {
    "@infoschematics/domain-model": "0.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/infoschematics/infoschematics.git",
    "directory": "packages/domain-core"
  },
  "scripts": {
    "build": "bun run clean && tsc -p tsconfig.build.json && node build.mjs ../../LICENSE dist/LICENSE",
    "clean": "node build.mjs --clean"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./dist/index.d.ts"
}
