{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "packages/*": {
      "entry": ["src/*.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/site": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "examples/*": {
      "project": ["src/**/*.ts"]
    },
    ".": {
      "entry": ["scripts/**/*.ts"],
      "project": ["scripts/**/*.ts"]
    }
  },
  "ignore": [".claude/skills/**", ".agents/skills/**"],
  "ignoreDependencies": ["syncpack"],
  "ignoreExportsUsedInFile": true,
  "exclude": ["duplicates"]
}
