{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "infoschematics-website",
  "compatibility_date": "2026-09-02",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "infoschematics.info",
      "custom_domain": true
    },
    {
      "pattern": "www.infoschematics.info",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
