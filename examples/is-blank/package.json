{
  "name": "@infoschematics/is-blank",
  "description": "A blank Infoschematic definition for examples and host integration checks.",
  "version": "0.1.0",
  "dependencies": {
    "@infoschematics/domain-core": "0.1.0"
  },
  "devDependencies": {
    "@infoschematics/cli": "0.1.0"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "infoschematics": {
    "examples": [
      {
        "export": "blankInfoschematic",
        "id": "blank",
        "source": "infoschematic.yaml",
        "title": "A blank Infoschematic"
      }
    ]
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "bun run check",
    "check": "infoschematics render infoschematic.yaml --output /dev/null",
    "render": "infoschematics render infoschematic.yaml --output infoschematic.svg",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "type": "module"
}
