{
  "name": "@infoschematics/is-system",
  "description": "An authored Infoschematic of the four-stage journey from signals to a shared view.",
  "version": "0.1.0",
  "dependencies": {
    "@infoschematics/domain-core": "0.1.0"
  },
  "devDependencies": {
    "@infoschematics/cli": "0.1.0"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "infoschematics": {
    "examples": [
      {
        "export": "systemExample",
        "id": "system",
        "source": "infoschematic.yaml",
        "title": "A system, explained"
      }
    ]
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "bun run check",
    "check": "infoschematics render infoschematic.yaml --output /dev/null",
    "render": "infoschematics render infoschematic.yaml --output infoschematic.svg",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "type": "module"
}
